<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ControlTheme x:Key="PlayButton" TargetType="Button" BasedOn="{StaticResource GlyphButton}">
    <Setter Property="Width" Value="36" />
    <Setter Property="Height" Value="36" />
    <Setter Property="Background" Value="{StaticResource PlayButtonFill}" />
    <Setter Property="Foreground" Value="#08080A" />
    <Setter Property="FontFamily" Value="{StaticResource GlyphFont}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Grid>
          <Border Name="PART_PlayBg" Background="{TemplateBinding Background}" CornerRadius="18" />
          <Border Name="PART_PlayOverlay" Background="Transparent" CornerRadius="18" />
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Grid>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover /template/ Border#PART_PlayOverlay">
      <Setter Property="Background" Value="{StaticResource PlayButtonHover}" />
    </Style>
    <Style Selector="^:pressed /template/ Border#PART_PlayOverlay">
      <Setter Property="Background" Value="{StaticResource PlayButtonPressed}" />
    </Style>
    <Style Selector="^:disabled">
      <Setter Property="Opacity" Value="0.3" />
    </Style>
  </ControlTheme>
</ResourceDictionary>
