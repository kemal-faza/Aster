<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ControlTheme x:Key="SettingsNavItem" TargetType="RadioButton">
    <Setter Property="Height" Value="38" />
    <Setter Property="Margin" Value="0,0,0,3" />
    <Setter Property="Padding" Value="10,0" />
    <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
    <Setter Property="FocusAdorner" Value="{x:Null}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="PART_Bg" Background="Transparent" CornerRadius="10"
                BorderBrush="Transparent" BorderThickness="1"
                Padding="{TemplateBinding Padding}">
          <ContentPresenter Foreground="{TemplateBinding Foreground}"
                            FontFamily="{TemplateBinding FontFamily}"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            VerticalAlignment="Center" />
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:checked /template/ Border#PART_Bg">
      <Setter Property="Background" Value="#12FFFFFF" />
    </Style>
    <Style Selector="^:checked">
      <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
    </Style>
    <Style Selector="^:pointerover /template/ Border#PART_Bg">
      <Setter Property="Background" Value="#0FFFFFFF" />
    </Style>
    <Style Selector="^:pointerover">
      <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
    </Style>
    <Style Selector="^:focus-visible /template/ Border#PART_Bg">
      <Setter Property="BorderBrush" Value="{StaticResource TextTertiary}" />
    </Style>
  </ControlTheme>
</ResourceDictionary>
