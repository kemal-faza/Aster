<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ControlTheme x:Key="GlyphButton" TargetType="Button">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="#D9FFFFFF" />
    <Setter Property="FontFamily" Value="{StaticResource GlyphFont}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Width" Value="32" />
    <Setter Property="Height" Value="32" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="PART_Bg" Background="{TemplateBinding Background}" CornerRadius="16">
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover /template/ Border#PART_Bg">
      <Setter Property="Background" Value="#1AFFFFFF" />
    </Style>
    <Style Selector="^:pressed /template/ Border#PART_Bg">
      <Setter Property="Background" Value="#2EFFFFFF" />
    </Style>
    <Style Selector="^:disabled">
      <Setter Property="Opacity" Value="0.3" />
    </Style>
  </ControlTheme>
</ResourceDictionary>
