<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ControlTheme x:Key="AsterScrollBar" TargetType="ScrollBar">
    <Setter Property="Width" Value="8" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Template">
      <ControlTemplate>
        <Track Name="PART_Track" Orientation="Vertical" IsDirectionReversed="True"
               Minimum="{TemplateBinding Minimum}"
               Maximum="{TemplateBinding Maximum}"
               Value="{TemplateBinding Value, Mode=TwoWay}"
               ViewportSize="{TemplateBinding ViewportSize}">
          <Track.DecreaseButton>
            <RepeatButton Opacity="0" Focusable="False" />
          </Track.DecreaseButton>
          <Track.Thumb>
            <Thumb MinHeight="32">
              <Thumb.Template>
                <ControlTemplate>
                  <Border Background="{StaticResource ScrollbarThumb}" CornerRadius="4" Margin="1,2" />
                </ControlTemplate>
              </Thumb.Template>
            </Thumb>
          </Track.Thumb>
          <Track.IncreaseButton>
            <RepeatButton Opacity="0" Focusable="False" />
          </Track.IncreaseButton>
        </Track>
      </ControlTemplate>
    </Setter>
  </ControlTheme>
</ResourceDictionary>
