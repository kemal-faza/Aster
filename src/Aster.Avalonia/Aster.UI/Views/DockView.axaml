<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:automation="using:Avalonia.Automation"
             xmlns:vm="using:Aster.UI.ViewModels"
             xmlns:controls="using:Aster.UI.Controls"
             x:Class="Aster.UI.Views.DockView"
             x:DataType="vm:ShellViewModel">
  <Grid ColumnDefinitions="Auto,*,Auto">
    <Button Grid.Column="0" Theme="{StaticResource GlyphButton}" Width="28" Height="24"
            Content="{Binding ChevronGlyph}" Click="OnCollapseClick"
            HorizontalAlignment="Left"
            automation:AutomationProperties.Name="Collapse"
            ToolTip.Tip="Collapse" />

    <Border Grid.Column="1" Width="280" Height="28" CornerRadius="14"
            HorizontalAlignment="Center" VerticalAlignment="Center"
            Background="{StaticResource DockSurface}" BorderBrush="{StaticResource DockStroke}"
            BorderThickness="1" Padding="2,1">
      <controls:PillStrip x:Name="DockTabs" EqualWidth="True" Spacing="0"
                          PillBrush="{StaticResource TabPillFill}" PillCornerRadius="12">
        <RadioButton x:Name="MusicTab" Theme="{StaticResource TabButton}" GroupName="Dock"
                     Tag="Music" IsChecked="True" IsCheckedChanged="OnTabChecked">
          <StackPanel Orientation="Horizontal" Spacing="5">
            <TextBlock Text="{Binding MusicGlyph}" FontFamily="{StaticResource GlyphFont}" FontSize="12" />
            <TextBlock Text="Music" FontSize="9.5" FontWeight="Medium" />
          </StackPanel>
        </RadioButton>
        <RadioButton x:Name="CameraTab" Theme="{StaticResource TabButton}" GroupName="Dock"
                     Tag="Camera" IsEnabled="False" IsCheckedChanged="OnTabChecked">
          <StackPanel Orientation="Horizontal" Spacing="5">
            <TextBlock Text="{Binding CameraGlyph}" FontFamily="{StaticResource GlyphFont}" FontSize="12" />
            <TextBlock Text="Camera" FontSize="9.5" FontWeight="Medium" />
          </StackPanel>
        </RadioButton>
        <RadioButton x:Name="ShelfTab" Theme="{StaticResource TabButton}" GroupName="Dock"
                     Tag="Shelf" IsEnabled="{Binding HasShelf}" IsCheckedChanged="OnTabChecked">
          <Grid>
            <StackPanel Orientation="Horizontal" Spacing="5">
              <TextBlock Text="{Binding ShelfGlyph}" FontFamily="{StaticResource GlyphFont}" FontSize="12" />
              <TextBlock Text="Shelf" FontSize="9.5" FontWeight="Medium" />
            </StackPanel>
            <Border Width="4" Height="4" CornerRadius="2"
                    Background="{StaticResource LyricsAccent}"
                    HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="0,-2,-2,0"
                    IsVisible="{Binding Shelf.HasItems, FallbackValue=False}" />
          </Grid>
        </RadioButton>
        <RadioButton x:Name="FocusTab" Theme="{StaticResource TabButton}" GroupName="Dock"
                     Tag="Focus" IsCheckedChanged="OnTabChecked">
          <Grid>
            <StackPanel Orientation="Horizontal" Spacing="5">
              <TextBlock Text="{Binding FocusGlyph}" FontFamily="{StaticResource GlyphFont}" FontSize="12" />
              <TextBlock Text="Focus" FontSize="9.5" FontWeight="Medium" />
            </StackPanel>
            <Border Width="4" Height="4" CornerRadius="2"
                    Background="{StaticResource FocusAccent}"
                    HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="0,-2,-2,0"
                    IsVisible="{Binding Focus.HasSession}" />
          </Grid>
        </RadioButton>
      </controls:PillStrip>
    </Border>

    <Button Grid.Column="2" Theme="{StaticResource GlyphButton}" Width="28" Height="24"
            Content="{Binding SettingsGlyph}" Click="OnSettingsClick"
            HorizontalAlignment="Right"
            automation:AutomationProperties.Name="Settings"
            ToolTip.Tip="Settings" />
  </Grid>
</UserControl>
