<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Aster.UI.ViewModels"
             xmlns:controls="using:Aster.UI.Controls"
             x:Class="Aster.UI.Views.DockView"
             x:DataType="vm:ShellViewModel">
  <Grid ColumnDefinitions="280,Auto">
    <Border Grid.Column="0" Width="280" Height="28" CornerRadius="14"
            Background="{StaticResource DockSurface}" BorderBrush="{StaticResource DockStroke}"
            BorderThickness="1">
      <StackPanel Orientation="Horizontal" Margin="2,0,0,0">
        <RadioButton Theme="{StaticResource TabButton}" GroupName="Dock"
                     Tag="Music" IsChecked="True">
          <StackPanel Orientation="Horizontal" Spacing="5">
            <TextBlock Text="{Binding MusicGlyph}" FontFamily="{StaticResource GlyphFont}" FontSize="12" />
            <TextBlock Text="Music" FontSize="9.5" FontWeight="Medium" />
          </StackPanel>
        </RadioButton>
        <RadioButton Theme="{StaticResource TabButton}" GroupName="Dock"
                     Tag="Camera" IsEnabled="False" Opacity="0.35">
          <StackPanel Orientation="Horizontal" Spacing="5">
            <TextBlock Text="{Binding CameraGlyph}" FontFamily="{StaticResource GlyphFont}" FontSize="12" />
            <TextBlock Text="Camera" FontSize="9.5" FontWeight="Medium" />
          </StackPanel>
        </RadioButton>
        <RadioButton Theme="{StaticResource TabButton}" GroupName="Dock"
                     Tag="Shelf" IsEnabled="False" Opacity="0.35">
          <StackPanel Orientation="Horizontal" Spacing="5">
            <TextBlock Text="{Binding ShelfGlyph}" FontFamily="{StaticResource GlyphFont}" FontSize="12" />
            <TextBlock Text="Shelf" FontSize="9.5" FontWeight="Medium" />
          </StackPanel>
        </RadioButton>
        <RadioButton Theme="{StaticResource TabButton}" GroupName="Dock"
                     Tag="Focus" IsEnabled="False" Opacity="0.35">
          <StackPanel Orientation="Horizontal" Spacing="5">
            <TextBlock Text="{Binding FocusGlyph}" FontFamily="{StaticResource GlyphFont}" FontSize="12" />
            <TextBlock Text="Focus" FontSize="9.5" FontWeight="Medium" />
          </StackPanel>
        </RadioButton>
      </StackPanel>
    </Border>
    <Button Grid.Column="1" Theme="{StaticResource GlyphButton}" Width="28" Height="24"
            Margin="4,0,0,0" Content="{Binding ChevronGlyph}" Click="OnCollapseClick" />
  </Grid>
</UserControl>
