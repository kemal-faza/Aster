<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Aster.UI.ViewModels"
             xmlns:primitives="using:Avalonia.Controls.Primitives"
             xmlns:automation="using:Avalonia.Automation"
             x:Class="Aster.UI.Views.ShelfView"
             x:DataType="vm:ShelfViewModel"
             Focusable="False">
  <UserControl.Resources>
    <ControlTheme x:Key="ShelfClearButton" TargetType="Button">
      <Setter Property="Background" Value="{StaticResource DockSurface}" />
      <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="8,0" />
      <Setter Property="Height" Value="16" />
      <Setter Property="FontSize" Value="9" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Name="PART_Bg"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{StaticResource DockStroke}"
                  BorderThickness="1"
                  CornerRadius="8"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter Content="{TemplateBinding Content}"
                              Foreground="{TemplateBinding Foreground}"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center" />
          </Border>
        </ControlTemplate>
      </Setter>
      <Style Selector="^:pointerover /template/ Border#PART_Bg">
        <Setter Property="Background" Value="{StaticResource ShelfCardHoverFill}" />
      </Style>
      <Style Selector="^:pressed /template/ Border#PART_Bg">
        <Setter Property="Background" Value="{StaticResource ShelfCardStroke}" />
      </Style>
    </ControlTheme>
  </UserControl.Resources>

  <UserControl.Styles>
    <Style Selector="Border.shelfCard">
      <Setter Property="Background" Value="{StaticResource ShelfCardFill}" />
      <Setter Property="BorderBrush" Value="{StaticResource ShelfCardStroke}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Border.shelfCard.missing">
      <Setter Property="Cursor" Value="Arrow" />
    </Style>
    <Style Selector="Border.shelfCard:pointerover">
      <Setter Property="Background" Value="{StaticResource ShelfCardHoverFill}" />
      <Setter Property="BorderBrush" Value="{StaticResource ShelfCardHoverStroke}" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="18,*,18">
    <Grid Grid.Row="0" Margin="4,0,4,0">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">
        <TextBlock Text="SHELF"
                   FontSize="9"
                   FontWeight="SemiBold"
                   Foreground="{StaticResource TextSecondary}" />
        <TextBlock Text="{Binding CountText}"
                   FontSize="9"
                   Foreground="{StaticResource TextTertiary}"
                   VerticalAlignment="Center" />
      </StackPanel>
    </Grid>

    <Grid Grid.Row="1">
      <ItemsControl ItemsSource="{Binding Items}"
                    IsVisible="{Binding HasItems}"
                    Margin="4,0,4,0">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <primitives:UniformGrid Columns="4" Rows="2" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:ShelfItemViewModel">
            <Border Classes="shelfCard"
                    Classes.missing="{Binding !Exists}"
                    Width="106" Height="65" Margin="2"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Opacity="{Binding Opacity}"
                    ToolTip.Tip="{Binding Path}"
                    automation:AutomationProperties.Name="{Binding Name}"
                    DoubleTapped="OnCardDoubleTapped"
                    PointerPressed="OnCardPointerPressed"
                    PointerMoved="OnCardPointerMoved"
                    PointerReleased="OnCardPointerReleased">
              <Grid>
                <Grid Margin="7" ColumnDefinitions="30,6,*" RowDefinitions="*,Auto">
                  <Border Grid.RowSpan="2"
                          Width="30" Height="30"
                          CornerRadius="8"
                          VerticalAlignment="Center"
                          Background="{Binding BadgeBackground}">
                    <TextBlock Text="{Binding BadgeText}"
                               FontSize="8.5"
                               FontWeight="SemiBold"
                               Foreground="{Binding BadgeForeground}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                  </Border>
                  <TextBlock Grid.Column="2"
                             Text="{Binding Name}"
                             FontSize="9.5"
                             FontWeight="SemiBold"
                             Foreground="{StaticResource TextPrimary}"
                             TextWrapping="Wrap"
                             TextTrimming="CharacterEllipsis"
                             LineHeight="12"
                             MaxHeight="26"
                             Margin="0,0,14,0"
                             VerticalAlignment="Center" />
                  <TextBlock Grid.Row="1"
                             Grid.Column="2"
                             Text="{Binding SizeLabel}"
                             FontSize="8"
                             Foreground="{Binding SizeBrush}"
                             TextTrimming="CharacterEllipsis"
                             Margin="0,1,0,0" />
                </Grid>
                <Button Theme="{StaticResource GlyphButton}"
                        Width="16" Height="16"
                        FontFamily="{StaticResource UiFont}"
                        FontSize="11"
                        Content="×"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="0,4,4,0"
                        automation:AutomationProperties.Name="{Binding RemoveLabel}"
                        ToolTip.Tip="Remove from shelf"
                        Click="OnRemoveClick" />
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <Grid IsVisible="{Binding !HasItems}" Margin="4,0,4,0">
        <Rectangle Stroke="#2EFFFFFF"
                   StrokeThickness="1.2"
                   StrokeDashArray="4,3"
                   RadiusX="12"
                   RadiusY="12" />
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
          <TextBlock Text="{Binding ShelfGlyph}"
                     FontFamily="{StaticResource GlyphFont}"
                     FontSize="24"
                     Foreground="#33FFFFFF"
                     HorizontalAlignment="Center" />
          <TextBlock Text="Drag files here"
                     FontSize="11"
                     Foreground="{StaticResource TextSecondary}"
                     HorizontalAlignment="Center"
                     Margin="0,4,0,0" />
          <TextBlock Text="They stay until you close the app"
                     FontSize="9"
                     Foreground="{StaticResource TextTertiary}"
                     HorizontalAlignment="Center"
                     Margin="0,2,0,0" />
        </StackPanel>
      </Grid>
    </Grid>

    <Button Grid.Row="2"
            Theme="{StaticResource ShelfClearButton}"
            Content="Clear"
            IsVisible="{Binding HasItems}"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Click="OnClearClick"
            automation:AutomationProperties.Name="Clear shelf" />
  </Grid>
</UserControl>
