<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Aster.UI.ViewModels"
             xmlns:controls="using:Aster.UI.Controls"
             xmlns:views="using:Aster.UI.Views"
             x:Class="Aster.UI.Views.CompactView"
             x:DataType="vm:ShellViewModel">
  <Grid ColumnDefinitions="*,Auto" Margin="14,0">
    <Grid IsVisible="{Binding HasNoMedia}">
      <TextBlock Text="{Binding ClockText}" FontSize="15" FontWeight="SemiBold"
                 Foreground="{StaticResource ClockText}" VerticalAlignment="Center"
                 HorizontalAlignment="Center" />
    </Grid>
    <Grid IsVisible="{Binding HasMedia}" ColumnDefinitions="22,8,*,Auto">
      <Border Width="22" Height="22" CornerRadius="7" ClipToBounds="True">
        <Image Source="{Binding Media.ArtworkImage}" Stretch="UniformToFill" />
      </Border>
      <TextBlock Grid.Column="2" Text="{Binding Media.Title}" FontSize="12"
                 Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"
                 TextTrimming="CharacterEllipsis" />
      <views:EqualizerView Grid.Column="3" IsPlaying="{Binding Media.IsPlaying}"
                           VerticalAlignment="Center" />
    </Grid>
    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                VerticalAlignment="Center">
      <controls:BatteryWidget Width="24" Height="12"
                              Percent="{Binding BatteryPercent}"
                              IsCharging="{Binding IsCharging}"
                              HasBattery="{Binding HasBattery}" />
      <TextBlock Text="{Binding BatteryText}" FontSize="9.5"
                 Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" />
      <TextBlock Text="{Binding WifiGlyph}" FontFamily="{StaticResource GlyphFont}"
                 FontSize="11" Foreground="{StaticResource TextSecondary}"
                 Opacity="{Binding WifiOpacity}" VerticalAlignment="Center" />
    </StackPanel>
  </Grid>
</UserControl>
