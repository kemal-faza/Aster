<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Aster.UI.Views.EqualizerView">
  <!-- Keep the centers on one horizontal axis; percent units keep the scale
       origin relative (bare "0.5,0.5" parses as absolute pixels). -->
  <Grid Height="20" ColumnDefinitions="4,2,4,2,4,2,4,2,4" VerticalAlignment="Center">
    <Border x:Name="Bar1" Grid.Column="0" Width="4" Height="10" CornerRadius="1.5"
            Background="{StaticResource ArtworkAccentFallback}"
            VerticalAlignment="Center"
            RenderTransformOrigin="50%,50%">
      <Border.RenderTransform><ScaleTransform ScaleY="0.3" /></Border.RenderTransform>
    </Border>
    <Border x:Name="Bar2" Grid.Column="2" Width="4" Height="14" CornerRadius="1.5"
            Background="{StaticResource ArtworkAccentFallback}"
            VerticalAlignment="Center"
            RenderTransformOrigin="50%,50%">
      <Border.RenderTransform><ScaleTransform ScaleY="0.3" /></Border.RenderTransform>
    </Border>
    <Border x:Name="Bar3" Grid.Column="4" Width="4" Height="20" CornerRadius="1.5"
            Background="{StaticResource ArtworkAccentFallback}"
            VerticalAlignment="Center"
            RenderTransformOrigin="50%,50%">
      <Border.RenderTransform><ScaleTransform ScaleY="0.3" /></Border.RenderTransform>
    </Border>
    <Border x:Name="Bar4" Grid.Column="6" Width="4" Height="12" CornerRadius="1.5"
            Background="{StaticResource ArtworkAccentFallback}"
            VerticalAlignment="Center"
            RenderTransformOrigin="50%,50%">
      <Border.RenderTransform><ScaleTransform ScaleY="0.3" /></Border.RenderTransform>
    </Border>
    <Border x:Name="Bar5" Grid.Column="8" Width="4" Height="16" CornerRadius="1.5"
            Background="{StaticResource ArtworkAccentFallback}"
            VerticalAlignment="Center"
            RenderTransformOrigin="50%,50%">
      <Border.RenderTransform><ScaleTransform ScaleY="0.3" /></Border.RenderTransform>
    </Border>
  </Grid>
</UserControl>
