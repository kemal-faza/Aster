<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Aster.UI.ViewModels"
        xmlns:views="using:Aster.UI.Views"
        x:Class="Aster.UI.Views.MainWindow"
        x:DataType="vm:ShellViewModel"
        Title="Aster Lab Avalonia"
        Width="300" Height="38"
        MinWidth="0" MinHeight="0"
        WindowDecorations="None"
        TransparencyLevelHint="Transparent"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        CanResize="False"
        WindowStartupLocation="Manual">
  <views:IslandShell x:Name="IslandShell" />
</Window>
