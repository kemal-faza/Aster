<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Aster.UI.ViewModels"
             xmlns:views="using:Aster.UI.Views"
             xmlns:controls="using:Aster.UI.Controls"
             x:Class="Aster.UI.Views.IslandShell"
             x:DataType="vm:ShellViewModel">
  <Border x:Name="Island" CornerRadius="0,0,22,22" ClipToBounds="False">
    <Grid>
      <Border x:Name="GlassBackground" CornerRadius="0,0,22,22"
              Background="{StaticResource IslandGlassBackground}"
              IsVisible="{Binding GlassBackground}" />
      <Border x:Name="SolidBackground" CornerRadius="0,0,22,22"
              Background="{StaticResource IslandSolidBackground}"
              IsVisible="{Binding !GlassBackground}" />
      <Border x:Name="GlassRim" Margin="1" CornerRadius="0,0,21,21"
              BorderBrush="{StaticResource IslandRimBrush}" BorderThickness="0,0,1,1"
              IsHitTestVisible="False" />
      <Ellipse Width="300" Height="220"
               HorizontalAlignment="Left" VerticalAlignment="Top"
               Margin="-70,-74,0,0"
               IsHitTestVisible="False"
               Opacity="{Binding ExpandedOpacity}"
               Fill="{Binding Media.AccentGlowBrush}" />
      <Grid x:Name="CollapsedLayer" Opacity="{Binding CollapsedOpacity}"
            IsVisible="{Binding !IsMinimal}">
        <views:CompactView />
      </Grid>
      <Grid x:Name="ExpandedLayer" Opacity="{Binding ExpandedOpacity}" Margin="18,18,18,14"
            RowDefinitions="18,*,28" IsVisible="{Binding !IsMinimal}">
        <views:HeaderView />
        <Grid Grid.Row="1">
          <views:MusicView IsVisible="{Binding IsMusicMode}" />
          <Grid IsVisible="{Binding IsFocusMode}">
            <views:FocusView DataContext="{Binding Focus}" />
          </Grid>
          <Grid IsVisible="{Binding ShowShelfPanel}">
            <views:ShelfView x:Name="ShelfView" DataContext="{Binding Shelf}" />
          </Grid>
        </Grid>
        <views:DockView x:Name="DockView" Grid.Row="2" />
      </Grid>
      <Grid x:Name="DropOverlay" IsVisible="False" IsHitTestVisible="False">
        <Border Background="#E6070708" CornerRadius="0,0,22,22" />
        <Rectangle Margin="2"
                   Stroke="{StaticResource LyricsAccent}"
                   StrokeThickness="1.5"
                   StrokeDashArray="4,3"
                   RadiusX="12"
                   RadiusY="12" />
        <StackPanel HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="4">
          <TextBlock Text="{Binding ShelfGlyph}"
                     FontFamily="{StaticResource GlyphFont}"
                     FontSize="24"
                     Foreground="{StaticResource LyricsAccent}"
                     HorizontalAlignment="Center" />
          <TextBlock Text="Drop to add to shelf"
                     FontSize="10"
                     Foreground="{StaticResource TextSecondary}"
                     HorizontalAlignment="Center" />
        </StackPanel>
      </Grid>
      <controls:ToastHost DataContext="{Binding Toast}"
                          x:Name="Toast" VerticalAlignment="Top" Margin="0,5,0,0" />
    </Grid>
  </Border>
</UserControl>
