<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Aster.UI.ViewModels"
             xmlns:automation="using:Avalonia.Automation"
             xmlns:controls="using:Aster.UI.Controls"
             xmlns:documents="using:Avalonia.Controls.Documents"
             x:Class="Aster.UI.Views.FocusView"
             x:DataType="vm:FocusViewModel"
             Width="464" Height="170">
  <Grid ColumnDefinitions="188,*">
    <Grid Grid.Column="0" Width="150" Height="150"
          HorizontalAlignment="Center" VerticalAlignment="Center">
      <Ellipse Width="144" Height="144" Stroke="#14FFFFFF" StrokeThickness="6" />
      <Ellipse x:Name="FullRing" Width="144" Height="144"
               Stroke="{StaticResource FocusAccent}" StrokeThickness="6"
               IsVisible="False" />
      <Path x:Name="ProgressArc" Stroke="{StaticResource FocusAccent}" StrokeThickness="6"
            StrokeLineCap="Round" Fill="Transparent" />
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
        <TextBlock Text="{Binding CountdownText}" FontSize="30" FontWeight="SemiBold"
                   documents:TextElement.FontFeatures="tnum"
                   Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Center" />
        <TextBlock Text="{Binding RingPhase}" FontSize="8.5" FontWeight="SemiBold"
                   Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center"
                   Margin="0,3,0,0" />
      </StackPanel>
    </Grid>

    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
      <TextBlock Text="{Binding Title}" FontSize="24" FontWeight="SemiBold"
                 Foreground="{StaticResource TextPrimary}" TextTrimming="CharacterEllipsis" />
      <Border Classes="chipBar" Margin="0,9,0,0" HorizontalAlignment="Left">
        <controls:PillStrip x:Name="PhasePill" Spacing="2"
                            PillBrush="{StaticResource TabPillFill}" PillCornerRadius="10">
          <Button x:Name="FocusChipButton" Classes="chip" Classes.active="{Binding IsFocusPhase}"
                  Content="{Binding FocusChipText}" Command="{Binding SelectFocusCommand}"
                  automation:AutomationProperties.Name="Focus duration" />
          <Button x:Name="ShortChipButton" Classes="chip" Classes.active="{Binding IsShortBreakPhase}"
                  Content="{Binding ShortChipText}" Command="{Binding SelectShortCommand}"
                  automation:AutomationProperties.Name="Short break duration" />
          <Button x:Name="LongChipButton" Classes="chip" Classes.active="{Binding IsLongBreakPhase}"
                  Content="{Binding LongChipText}" Command="{Binding SelectLongCommand}"
                  automation:AutomationProperties.Name="Long break duration" />
        </controls:PillStrip>
      </Border>
      <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,9,0,0">
        <Button Classes="focusPrimary" Content="{Binding StartLabel}"
                Command="{Binding ToggleCommand}" IsVisible="{Binding IsStartVisible}"
                automation:AutomationProperties.Name="{Binding StartLabel}" />
        <Button Classes="focusGhost" Content="Reset" Command="{Binding ResetCommand}"
                automation:AutomationProperties.Name="Reset focus timer" />
        <Button Classes="focusPrimary" Content="{Binding BreakLabel}"
                Command="{Binding StartBreakCommand}" IsVisible="{Binding IsBreakVisible}"
                automation:AutomationProperties.Name="{Binding BreakLabel}" />
      </StackPanel>
    </StackPanel>
  </Grid>
</UserControl>
